{
  "version": "v1",
  "hooks": [
    {
      "name": "Beyin SessionStart",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand "
      },
      "timeout": 25
    },
    {
      "name": "Beyin UserPromptSubmit",
      "trigger": "UserPromptSubmit",
      "action": {
        "type": "command",
        "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand "
      },
      "timeout": 25
    },
    {
      "name": "Beyin PostToolUse",
      "trigger": "PostToolUse",
      "action": {
        "type": "command",
        "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand "
      },
      "timeout": 25,
      "matcher": "write"
    },
    {
      "name": "Beyin Stop",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand "
      },
      "timeout": 25
    }
  ]
}
